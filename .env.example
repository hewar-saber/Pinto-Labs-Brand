# The single shared password for the whole site. Required — with it unset the
# app refuses every request rather than serving the library unprotected.
BRAND_PASSWORD=

# Optional. Extra secret mixed into the session cookie's HMAC, so sessions can
# be invalidated without changing BRAND_PASSWORD. Defaults to BRAND_PASSWORD.
BRAND_SESSION_SECRET=

# Optional. Session lifetime in days. Defaults to 30.
BRAND_SESSION_DAYS=
